{
  "schemaVersion": 1,
  "id": "blockvault",
  "version": "${version}",
  "name": "BlockVault",
  "description": "Alpha test: do not use passwords you care about yet. Built-in prompt and result detection is English-only. Stores encrypted data in your BlockVault data folder; see the README for its location.",
  "icon": "assets/blockvault/icon.png",
  "authors": ["SilkyPanda"],
  "contact": {
    "sources": "https://github.com/SilkyPanda/BlockVault"
  },
  "license": "GPL-3.0-only",
  "mixins": ["blockvault.mixins.json"],
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.silkypanda.blockvault.fabric.BlockVaultFabric"],
    "modmenu": ["io.github.silkypanda.blockvault.fabric.BlockVaultModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "yet_another_config_lib_v3": ">=3.9.7"
  }
}
