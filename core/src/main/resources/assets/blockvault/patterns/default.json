{
  "version": 1,
  "commandNames": {
    "login": [
      "login",
      "l",
      "log"
    ],
    "register": [
      "register",
      "reg"
    ],
    "changePassword": [
      "changepassword",
      "changepass",
      "cp"
    ],
    "unregister": [
      "unregister",
      "unreg"
    ]
  },
  "prompt": {
    "login": [
      "(?i)/login\\b",
      "(?i)/(?:l|log)\\s+<"
    ],
    "register": [
      "(?i)/(?:register|reg)\\b"
    ]
  },
  "result": {
    "success": [
      "(?i)(successful(?:ly)?\\s+(?:log(?:ged)?\\s*in|login|registered)|logged\\s+in\\s+successfully|you(?:'| a)re\\s+now\\s+logged\\s+in|login\\s+successful|registration\\s+successful|successfully\\s+registered)",
      "(?i)password\\s+(?:has\\s+been\\s+|was\\s+)?(?:successfully\\s+)?(?:changed|updated)",
      "(?i)(?:changed|updated)\\s+(?:your\\s+)?password\\s+successfully|successfully\\s+(?:changed|updated)\\s+(?:your\\s+)?password",
      "(?i)successfully\\s+unregistered|unregistered\\s+successfully|account\\s+(?:has\\s+been\\s+|was\\s+)?(?:successfully\\s+)?(?:unregistered|deleted|removed)"
    ],
    "failure": [
      "(?i)(wrong|incorrect|invalid)\\s+password|password\\s+(?:is\\s+)?(?:wrong|incorrect)",
      "(?i)(?:registration|register(?:ing)?|account creation)\\s+(?:has\\s+)?(?:failed|unsuccessful|error)",
      "(?i)\\b(?:login|log in|authentication)\\s+(?:has\\s+)?(?:failed|unsuccessful)|\\bincorrect\\s+(?:login|account)\\s+credentials\\b|\\balready\\s+logged\\s+in\\b"
    ],
    "passwordRules": [
      "(?i)(?:password|passphrase)\\s+(?:is\\s+)?too\\s+(?:short|long)",
      "(?i)(?:password|passphrase)\\s+must\\s+be\\s+(?:at\\s+least|no\\s+more\\s+than)",
      "(?i)(?:password|passphrase)\\s+contains?\\s+(?:illegal|invalid|forbidden|unallowed|disallowed|not allowed|not permitted)\\s+characters",
      "(?i)(?:too\\s+(?:short|long)|illegal|invalid|forbidden|unallowed|disallowed|not allowed|not permitted)\\s+characters?",
      "(?i)\\b(?:password|passphrase)\\b.{0,80}\\b(?:invalid\\s+(?:format|length)|must\\s+contain|weak|unsafe|not\\s+safe|isn't\\s+safe|is\\s+not\\s+safe|too\\s+common|too\\s+simple)\\b",
      "(?i)\\binvalid\\s+password\\s+(?:format|length)\\b",
      "(?i)\\bchosen\\s+password\\b.{0,80}\\b(?:weak|unsafe|not\\s+safe|isn't\\s+safe|is\\s+not\\s+safe|common)\\b",
      "(?i)\\bpassword\\s+too\\s+(?:short|long)\\b",
      "(?i)\\bpassword\\b.*\\b(?:unallowed|disallowed)\\s+characters?\\b",
      "(?i)\\b(?:maximum|minimum)\\s+of\\s+\\d+\\s+characters?",
      "(?i)\\bonly\\s+(?:alphanumeric|letters)\\b",
      "(?i)\\b(?:password|passphrase)\\b.*\\bbetween\\s+\\d+\\s+and\\s+\\d+"
    ]
  }
}
