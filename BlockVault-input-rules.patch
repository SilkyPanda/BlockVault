diff -ruN new/BlockVault-main/shared-client/src/main/java/io/github/silkypanda/blockvault/InputFilter.java patched/BlockVault-main/shared-client/src/main/java/io/github/silkypanda/blockvault/InputFilter.java
--- new/BlockVault-main/shared-client/src/main/java/io/github/silkypanda/blockvault/InputFilter.java	1970-01-01 00:00:00.000000000 +0000
+++ patched/BlockVault-main/shared-client/src/main/java/io/github/silkypanda/blockvault/InputFilter.java	2026-10-29 04:01:55.422042872 +0000
@@ -0,0 +1,48 @@
+package io.github.silkypanda.blockvault;
+
+import java.util.function.Consumer;
+import java.util.function.Predicate;
+import net.minecraft.client.gui.components.EditBox;
+
+/**
+ * Keeps a text field to the characters BlockVault accepts, using the rules in {@code InputRules}.
+ *
+ * <p>Typing one disallowed character simply does nothing. A paste that contains a disallowed character is
+ * rejected as a whole, so a password is never silently changed into a different one.
+ */
+final class InputFilter {
+    private InputFilter() { }
+
+    static void bind(EditBox box, Predicate<String> allowed, Consumer<String> responder) {
+        String[] accepted = { strip(box.getValue(), allowed) };
+        boolean[] adjusting = { false };
+        if (!accepted[0].equals(box.getValue())) {
+            adjusting[0] = true;
+            try { box.setValue(accepted[0]); }
+            finally { adjusting[0] = false; }
+        }
+        box.setResponder(value -> {
+            if (adjusting[0]) return;
+            String next = value;
+            if (!allowed.test(value)) {
+                next = value.length() <= accepted[0].length() + 1 ? strip(value, allowed) : accepted[0];
+                adjusting[0] = true;
+                try { box.setValue(next); }
+                finally { adjusting[0] = false; }
+            }
+            accepted[0] = next;
+            if (responder != null) responder.accept(next);
+        });
+    }
+
+    private static String strip(String value, Predicate<String> allowed) {
+        StringBuilder kept = new StringBuilder(value.length());
+        for (int i = 0; i < value.length(); ) {
+            int codePoint = value.codePointAt(i);
+            String character = new String(Character.toChars(codePoint));
+            if (allowed.test(character)) kept.append(character);
+            i += Character.charCount(codePoint);
+        }
+        return kept.toString();
+    }
+}
